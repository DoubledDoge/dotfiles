# Reduce keepalives while running on battery power.
Match exec "systemd-ac-power"
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlPersist 5m
    TCPKeepAlive no

Host *
    ExitOnForwardFailure yes

    StrictHostKeyChecking accept-new
    HashKnownHosts yes
    AddKeysToAgent yes

    ConnectTimeout 5
    ConnectionAttempts 3

    Compression yes
    IPQoS lowdelay

    ControlMaster auto
    ControlPersist 30m
    ControlPath ~/.ssh/control-%C

    TCPKeepAlive yes
    ServerAliveInterval 15
    ServerAliveCountMax 3