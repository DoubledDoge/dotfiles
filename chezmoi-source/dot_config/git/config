[core]
	compression = 9
	whitespace = blank-at-eol,blank-at-eof,space-before-tab
	preloadindex = true
	pager = delta
	excludesfile = ~/.config/git/ignore
	attributesFile = ~/.config/git/attributes
	editor = micro

[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false

[init]
	defaultBranch = main

[status]
	branch = true
	short = true
	showStash = true

[fetch]
	prune = true

[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = false
	context = 3
	renames = copies
	interHunkContext = 10

[push]
	autoSetupRemote = true
	default = current
	followTags = true

[pull]
	default = current
	rebase = true

[rebase]
	autoStash = true
	missingCommitsCheck = warn

[rerere]
	enabled = true

[log]
	abbrevCommit = true
	graphColors = blue,yellow,cyan,magenta,green,red

[branch]
	sort = -committerdate

[checkout]
	defaultRemote = origin

[tag]
	sort = -taggerdate

[interactive]
	diffFilter = delta --color-only
	singlekey = true

[include]
	path = ~/.config/git/personal.gitconfig
	path = ~/.config/git/theme.gitconfig
	path = ~/.config/git/gpg.gitconfig
	path = ~/.config/git/github.gitconfig
	path = ~/.config/git/alias.gitconfig
	path = ~/.config/git/url.gitconfig

[merge]
	conflictStyle = zdiff3

[commit]
	template = ~/.config/git/message
	verbose = false

[help]
	autocorrect = 15
