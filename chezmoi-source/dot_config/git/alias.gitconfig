[alias]
	ac = !git add -A && git commit
	st = status -sb
	pr = pull --rebase
	rh = reset HEAD
	tl = tag -l
	bra = branch -a
	cleanup = !git branch --merged | grep -v '*' | xargs git branch -d
	remotes = remote -v
	lg = log --all --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	conf = config --global
	cge = config --global --edit
	aa = add -A
	ap = add -p
	cdf = clean -df
	ds = diff --staged
	amend = commit -a --amend --no-edit
	ciam = commit -a --amend --no-edit
	ciamc = commit -a --amend --no-edit --no-verify