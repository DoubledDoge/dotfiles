[core]
	compression = 9
	whitespace = blank-at-eol,blank-at-eof,space-before-tab
	preloadindex = true
	pager = delta
	excludesfile = ~/.config/git/.gitignore_global
	attributesFile = ~/.config/git/.gitattributes_global
	editor = micro

[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false

[init]
	defaultBranch = main

[status]
	branch = true
	showStash = true

[fetch]
	prune = true

[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = false
	context = 3
	renames = true
	interHunkContext = 10

[color "diff"]
	meta = black bold
	frag = magenta
	context = white
	whitespace = yellow reverse
	old = red
	new = green

[push]
	autoSetupRemote = true
	default = current
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	missingCommitsCheck = warn

[rerere]
	enabled = true

[log]
	abbrevCommit = true
	graphColors = blue,yellow,cyan,magenta,green,red

[branch]
	sort = -committerdate

[checkout]
	defaultRemote = origin

[tag]
	sort = -taggerdate

[interactive]
	diffFilter = delta --color-only
	singlekey = true

[include]
	path = ~/.config/git/personal.gitconfig
	path = ~/.config/git/theme.gitconfig
	path = ~/.config/git/gpg.gitconfig
	path = ~/.config/git/github.gitconfig
	path = ~/.config/git/alias.gitconfig

[merge]
	conflictStyle = zdiff3

[commit]
	template = ~/.config/git/.gitmessage
	verbose = false

[help]
	autocorrect = 15
