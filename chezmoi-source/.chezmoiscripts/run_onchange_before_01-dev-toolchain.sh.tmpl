#!/usr/bin/env bash

set -euo pipefail

{{ template "common.sh" . }}

if [ ! -x /usr/local/bin/oh-my-posh ]; then
    install "oh-my-posh"
    curl -fsSL https://ohmyposh.dev/install.sh -o "$WORKDIR/ohmyposh-install.sh"
    as_root bash "$WORKDIR/ohmyposh-install.sh" -d /usr/local/bin
else
    skip "oh-my-posh"
fi

if [ ! -x "$HOME/.cargo/bin/cargo" ]; then
    install "rustup"
    curl -fsSL https://sh.rustup.rs -o "$WORKDIR/rustup-install.sh"
    sh "$WORKDIR/rustup-install.sh" -y --default-toolchain stable --no-modify-path
else
    skip "rustup"
fi

install "cargo-only tools"
{{ range .packages.cargo }}
if [ ! -x "$HOME/.cargo/bin/{{ .bin }}" ]; then
    "$HOME/.cargo/bin/cargo" install {{ .crate }}
fi
{{ end }}

if [ ! -x "$HOME/.local/bin/batman" ]; then
    log "Building bat-extras"
    git clone --branch master --recursive {{ .tools.bat_extras_repo }} "$WORKDIR/bat-extras"
    (cd "$WORKDIR/bat-extras" && ./build.sh --install --prefix="$HOME/.local")
else
    skip "bat-extras"
fi

log "Dev toolchain install complete"
