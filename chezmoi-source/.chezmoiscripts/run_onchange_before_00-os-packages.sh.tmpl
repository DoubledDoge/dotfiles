#!/usr/bin/env bash

set -euo pipefail

{{ template "common.sh" . }}
{{ template "detect-pkg-mgr.sh" . }}

log "Detected package manager: $DOTFILES_PKG_MGR"

case "$DOTFILES_PKG_MGR" in
    apt)
        as_root apt update
        as_root apt install -y \
            {{ range .packages.common }}{{ . }} {{ end }}\
            {{ range .packages.debian }}{{ . }} {{ end }}
        as_root locale-gen en_US.UTF-8
        ;;
    pacman)
        as_root pacman -Syu --needed --noconfirm \
            {{ range .packages.common }}{{ . }} {{ end }}\
            {{ range .packages.arch }}{{ . }} {{ end }}

        {{ if .archInstallParu }}
        if ! command -v paru >/dev/null 2>&1; then
            log "Bootstrapping paru from AUR"
            git clone --branch master https://aur.archlinux.org/paru.git "$WORKDIR/paru"
            (cd "$WORKDIR/paru" && makepkg -si --noconfirm)
        else
            skip "paru"
        fi
        {{ end }}
        ;;
    dnf)
        as_root dnf install -y --refresh \
            {{ range .packages.common }}{{ . }} {{ end }}\
            {{ range .packages.fedora }}{{ . }} {{ end }}
        ;;
esac

log "OS package install complete"
