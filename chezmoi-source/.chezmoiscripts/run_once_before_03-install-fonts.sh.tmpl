#!/usr/bin/env bash

set -euo pipefail

FONT_DIR="$HOME/.local/share/fonts/Monaspace"

if [ ! -d "$FONT_DIR" ]; then
    echo "==> Installing Monaspace Nerd Font"
    mkdir -p "$FONT_DIR"
    tmpdir="$(mktemp -d)"
    curl -fsSL "{{ .tools.nerd_font_url }}" -o "$tmpdir/font.zip"
    unzip -q "$tmpdir/font.zip" -d "$FONT_DIR"
    rm -rf "$tmpdir"
    fc-cache -f "$HOME/.local/share/fonts"
else
    echo "==> Monaspace Nerd Font already installed, skipping"
fi
