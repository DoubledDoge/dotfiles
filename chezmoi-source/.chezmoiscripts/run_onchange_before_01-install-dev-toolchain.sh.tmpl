#!/usr/bin/env bash

set -euo pipefail

if [ ! -x /usr/local/bin/oh-my-posh ]; then
    echo "==> Installing oh-my-posh"
    curl -fsSL https://ohmyposh.dev/install.sh -o /tmp/ohmyposh-install.sh
    chmod +x /tmp/ohmyposh-install.sh
    sudo bash /tmp/ohmyposh-install.sh -d /usr/local/bin
else
    echo "==> oh-my-posh already installed, skipping"
fi

if [ ! -x "$HOME/.cargo/bin/cargo" ]; then
    echo "==> Installing rustup"
    curl -fsSL https://sh.rustup.rs -o /tmp/rustup-install.sh
    sh /tmp/rustup-install.sh -y --default-toolchain stable --no-modify-path
else
    echo "==> rustup already installed, skipping"
fi

echo "==> Installing cargo-only tools"
{{ range .packages.cargo }}
if [ ! -x "$HOME/.cargo/bin/{{ .bin }}" ]; then
    "$HOME/.cargo/bin/cargo" install {{ .crate }}
fi
{{ end }}

if [ ! -x "$HOME/.local/bin/batman" ]; then
    echo "==> Building bat-extras"
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' EXIT
    git clone --branch master --recursive {{ .tools.bat_extras_repo }} "$tmpdir/bat-extras"
    (cd "$tmpdir/bat-extras" && ./build.sh --install --prefix="$HOME/.local")
else
    echo "==> bat-extras already installed, skipping"
fi

echo "==> Installing thefuck"
if ! pip install --user --break-system-packages thefuck; then
    echo "WARNING: thefuck failed to install. The fuck/fk aliases will stay" >&2
    echo "inactive - they're already guarded by a command -v check in" >&2
    echo "shell-common/functions.sh, so this is safe to ignore." >&2
fi

echo "==> Dev toolchain install complete"
